# Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------- Cloudinary (PS02)
# Console → Dashboard → "API environment variable". Enable the AI Vision add-on
# under Add-ons (free plan has a small monthly quota).
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_FOLDER=saakshi
AI_VISION_ENABLED=true
# Largest image the plan accepts (free: 10 MB); bigger photos are stored as a smaller copy
# CLOUDINARY_MAX_IMAGE_MB=10

# ---------------------------------------------------------------- Qdrant server (PS03)
# Local:  docker compose up -d qdrant   → http://127.0.0.1:6333 (no key, cluster mode = regional shards)
# Cloud:  https://cloud.qdrant.io free cluster → URL + API key
# A cluster-mode server gets one shard per project region; a standalone server
# gets one global shard. Saakshi detects which and adapts.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=saakshi_evidence

# ---------------------------------------------------------------- Field devices
# Where devices send photos (the Impact app)
IMPACT_URL=http://127.0.0.1:8000
# Shared secret between devices and Impact; pick any long random string.
# It is also the office key: Impact asks for it before uploads, edits, campaign
# images and AI change descriptions (reading the dashboard stays open).
INGEST_TOKEN=change-me-to-a-long-random-string
SYNC_INTERVAL_S=4
PULL_INTERVAL_S=20
DUPLICATE_THRESHOLD=0.95
# blur = upload a face-blurred copy; hold = keep on device until approved
PRIVACY_MODE=blur
CONFLICT_WINDOW_HOURS=6
# Originals kept on the device; beyond this, the oldest photos that are synced
# AND checked by HQ are released (vectors, note and thumbnail stay searchable)
MEDIA_BUDGET_MB=2048
# 1 = keep int8 copies of the vectors (4x less RAM for the search index)
EDGE_QUANTIZE=0
# Optional: phrase "Ask" answers with a small local model through Ollama, still offline
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2:1b

# ---------------------------------------------------------------- Impact app
ORG_NAME=Green Delta Collective (demo NGO)
# Set when deployed, e.g. https://saakshi-impact.onrender.com
PUBLIC_BASE_URL=
# Minimum hours between a "before" and an "after" photo of the same site
PAIR_MIN_GAP_HOURS=1

# Optional: rewrite report summaries with any OpenAI-compatible LLM (Gemini works too)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Advanced: server layout for small partial snapshots (see saakshi_core/qdrant_server.py)
# SAAKSHI_SEGMENTS_PER_SHARD=4
# SAAKSHI_INDEXING_THRESHOLD_KB=500

# Optional: where models and data are stored
# SAAKSHI_MODEL_DIR=~/.cache/saakshi-models
# SAAKSHI_DATA_DIR=./data
